# Configurações do Servidor
API_V1_STR=/api/v1
PROJECT_NAME="Inimigos do Prompt API"

# Provedor do Modelo de ML: "bertimbau", "sklearn", "huggingface_api" ou "gradio_space"
# Para execução local sem baixar BERTimbau de 400MB+, use "sklearn" ou "gradio_space"
MODEL_BACKEND=gradio_space

# Configuração Hugging Face Space (Gradio)
GRADIO_SPACE_URL=https://gustant1-inimigos-prompt.hf.space

# Configuração Hugging Face Hub (Download do Modelo)
HF_MODEL_ID=gustant1/bertimbau-sensacionalismo
LOCAL_MODEL_PATH=models/bertimbau_sensacionalismo_final

# Configuração Hugging Face Inference API (Opcional - caso MODEL_BACKEND=huggingface_api)
HUGGINGFACE_API_TOKEN=seu_token_aqui
HUGGINGFACE_API_URL=https://api-inference.huggingface.co/models/gustant1/bertimbau-sensacionalismo

# Autenticação Supabase (Obrigatório para validar JWTs do frontend)
# Encontrado em: Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=seu_jwt_secret_do_supabase_aqui
