# Copie este arquivo para .env e preencha com as chaves reais do Supabase
# Você encontra as chaves em: https://supabase.com/dashboard → Settings → API

VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# URL pública do site para onde o Supabase redireciona após verificação de e-mail.
# NÃO use localhost aqui — a extensão não tem URL pública.
# Use a URL do GitHub Pages ou do seu domínio.
VITE_SITE_URL=https://unb-sistemas-de-machine-learning.github.io/challenge_1_inimigos_do_prompt
